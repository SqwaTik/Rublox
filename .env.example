# ── Сервер ─────────────────────────────────────────────
PORT=8787
# Токен, который вводится в плагине Studio для авторизации соединения.
BRIDGE_TOKEN=change-me

# ── Выбор провайдера по умолчанию: anthropic | openai | local ──
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-8
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ── Anthropic (Claude) ─────────────────────────────────
ANTHROPIC_API_KEY=
# Официальный: https://api.anthropic.com
# Прокси-совместимые (напр. agentrouter.org) тоже подходят — сервер сам
# обрезает завершающий слэш и шлёт User-Agent клиента Claude Code.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── OpenAI (ChatGPT) ───────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Локальный OpenAI-совместимый сервер (Ollama, LM Studio, vLLM) ──
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=not-needed
LOCAL_MODEL=llama3.1

# ── Кастомные провайдеры ───────────────────────────────
# Опишите любые OpenAI/Anthropic-совместимые сервисы в providers.json
# (см. providers.example.json). Ключи к ним удобно держать здесь и
# ссылаться из providers.json через "apiKeyEnv".
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=

# ── Компрессия контекста ───────────────────────────────
# Порог в приблизительных токенах, после которого старая история сворачивается.
CONTEXT_COMPRESS_THRESHOLD=6000

# ── Локальный режим (выполнение команд на ПК при отключённом Roblox) ──
# Включать с осторожностью: разрешает выполнение shell-команд.
ALLOW_LOCAL_EXEC=false
